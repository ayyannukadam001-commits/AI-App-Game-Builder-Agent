# FreeLLMAPI server URL, for example http://127.0.0.1:3001
FREELLMAPI_BASE_URL=
# Unified FreeLLMAPI key. Keep this on the server only; never commit a real key.
FREELLMAPI_API_KEY=
# Optional model ID. If empty, the first model returned by /v1/models is used as default.
FREELLMAPI_MODEL=
PORT=8787
CORS_ORIGIN=