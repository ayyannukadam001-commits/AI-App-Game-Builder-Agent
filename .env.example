# Cloud AI gateway (OpenAI-compatible, for example a FreeLLMAPI endpoint).
# Keep the unified key on the backend only; never commit a real key.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=

# Optional local AI endpoint. The default is a local Ollama server.
# The endpoint must be reachable FROM THE NODE BACKEND, not just from the phone browser.
# Ollama model discovery uses /api/tags; chat uses /v1/chat/completions.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
# Optional: most local Ollama servers do not need an API key.
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=

PORT=8787
CORS_ORIGIN=
